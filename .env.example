# MADDIE configuration — copy to .env and fill in for your machine.
# Every variable has a placeholder default in the code; nothing here is secret
# except the API keys.

# ---------------------------------------------------------------- LLM backend
# When serving the model locally with vLLM (see vllm.sh), point OPENAI_BASE_URL
# at it; vLLM ignores the key, so "EMPTY" is fine.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=EMPTY
# Model name passed as --llm. Must match what the server advertises.
QWEN_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Local weights directory for `vllm serve`, if not pulling from the Hub.
QWEN_MODEL_PATH=Qwen/Qwen3-30B-A3B-Instruct-2507

# ------------------------------------------------- per-agent Python envs
# Each agent runs in its own environment; give the env prefix (conda) here.
MADDIE_ENV_HIT_IDENTIFIER=/path/to/envs/maddie-hit-identifier
MADDIE_ENV_EVALUATOR=/path/to/envs/maddie-evaluator
MADDIE_ENV_LEAD_OPTIMIZER=/path/to/envs/maddie-lead-optimizer
MADDIE_ENV_SYNTHESIZER=/path/to/envs/maddie-synthesizer
# Interpreter that runs the orchestrator itself (cli.py).
MADDIE_PYTHON=python

# ------------------------------------------------------------- LeadOptimizer
MADDIE_OPTIMIZER_RUNTIME=/path/to/lead_optimizer/runtime
GELLMO_REPO=${MADDIE_OPTIMIZER_RUNTIME}/GeLLMO-C
MOLOPT_REPO=${MADDIE_OPTIMIZER_RUNTIME}/mol-opt
MOLOPT_BENCHMARK_PATH=${MADDIE_OPTIMIZER_RUNTIME}/molopt_testing/agent_knowledge/molopt_benchmark_knowledge.json
GELLMO_BASE_MODEL=/path/to/models/llama31_8b_instruct
GELLMO_LORA_WEIGHTS=/path/to/models/gellmo_c_p10_llama_lora

# --------------------------------------------------------------- Synthesizer
# Directory holding meea.sif, prexsyn.sif and the MEEA model assets
# (eMoleculesBB.txt, EnamineREAL.txt, policy_model.ckpt, template_rules.dat,
# value_pc.pt).
MADDIE_SYNTHESIZER_ASSETS=/path/to/synthesizer-assets

# -------------------------------------------------------------- docking
# Uni-Dock is the default docking backend. Set this only if the `unidock`
# package is not already importable in the evaluator environment.
UNIDOCK_PATH=
# QuickVina2-CUDA fallback.
VINA_CUDA_DIR=/path/to/Vina-CUDA/QuickVina2-CUDA
VINA_CUDA_ENV=/path/to/envs/vina-cuda

# ------------------------------------------------- HitIdentifier generators
# Checkpoints for the vendored DiffSMol (LBDD) and conDitar (SBDD) models are
# configured in hit_identifier/config/runtime_config.json and the YAML files
# under hit_identifier/vendor/*/config*/.

# ------------------------------------------------------------- scratch space
MADDIE_TMP_DIR=/tmp

# -------------------------------------------------- benchmark run scripts
# Used by tests/run_*.sh; all default to sensible values under the repo root.
# PROJECT=/path/to/MADDIE
# BASE_DIR=${PROJECT}/runs/full
# LOCK_DIR=${PROJECT}/runs/node_locks
# PDB_DIR=${PROJECT}/dataset/pdbs
