Bootstrap: docker
From: python:3.10-slim

%files
    MEEA /opt/meea/MEEA

%post
    export DEBIAN_FRONTEND=noninteractive

    pip install --no-cache-dir \
        numpy==1.21.5 \
        pandas==1.3.5 \
        rdkit==2022.9.3 \
        torch==1.13.1 \
        tqdm==4.64.1

    pip install --no-cache-dir -e /opt/meea/MEEA/rdchiral

    chmod -R a+rX /usr/local/lib/python3.10
    chmod -R a+rX /usr/local/lib/python3.10/site-packages

%environment
    export PYTHONNOUSERSITE=1

%runscript
    cd /opt/meea/MEEA
    exec /bin/bash meea.sh "$@"
